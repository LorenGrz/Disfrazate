# Copiá este archivo a .env.local y completá los valores. .env.local nunca se commitea.
# En Vercel, cargá las mismas variables en Project Settings → Environment Variables.

# --- Generación de imágenes ---
# sagemaker = endpoint disfrazate-flux (real, se cobra por hora mientras esté prendido) · demo = imágenes de ejemplo, gratis
IMAGE_PROVIDER=demo

# AWS SageMaker (usuario IAM disfrazate-app, solo sagemaker:InvokeEndpoint sobre el endpoint).
# Prefijo APP_AWS_ y no AWS_: Vercel reserva AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.
# Las dos keys son obligatorias solo con IMAGE_PROVIDER=sagemaker.
APP_AWS_REGION=us-east-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
SAGEMAKER_ENDPOINT=disfrazate-flux

# --- Evento ---
# Código que se pide para usar el botón DISFRAZATE, así nadie de afuera gasta presupuesto.
EVENT_CODE=
# Tope total de imágenes generadas (corte de seguridad del presupuesto).
MAX_GENERATIONS=600

# --- Disfraces scrapeados y muro (Supabase) ---
# Sin NEXT_PUBLIC_SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY el botón "Scrapear" responde 503 y el resto de la app funciona igual.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scrapear disfraz ---
# Modelo de Bedrock (credenciales APP_AWS_*) que traduce y modera el texto del usuario.
BEDROCK_TEXT_MODEL=amazon.nova-micro-v1:0
# Tope de disfraces scrapeados guardados.
MAX_CUSTOM_COSTUMES=100
