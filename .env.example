# Copiá este archivo a .env.local y completá los valores. .env.local nunca se commitea.
# En Vercel, cargá las mismas variables en Project Settings → Environment Variables.

# --- Generación de imágenes ---
# bedrock = AWS Bedrock Nova Canvas (real, consume créditos) · demo = imágenes de ejemplo, gratis
IMAGE_PROVIDER=demo

# AWS Bedrock (usuario IAM disfrazate-app, solo bedrock:InvokeModel sobre Nova Canvas).
# Prefijo BEDROCK_ y no AWS_: Vercel reserva AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-canvas-v1:0
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# --- Evento ---
# Código que se pide para usar el botón DISFRAZATE, así nadie de afuera gasta los créditos.
EVENT_CODE=
# Tope total de imágenes generadas (corte de seguridad del presupuesto).
MAX_GENERATIONS=600

# --- Muro (Supabase, fase 3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
